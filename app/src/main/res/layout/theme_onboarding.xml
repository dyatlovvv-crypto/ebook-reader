<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EEF1F4"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="56dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Тема интерфейса"
            android:textColor="#1C1C1E"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:paddingBottom="20dp"
            android:text="Выберите подходящую вам тему. Выбор можно будет изменить позже в настройках."
            android:textColor="#5C5C5E"
            android:textSize="15sp" />

        <RadioGroup
            android:id="@+id/themeRadioGroup"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/themeOptLight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="#2A9D8F"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:text="Светлая\nКак страница чтения, светлый фон"
                android:textColor="#1C1C1E"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/themeOptDark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="#2A9D8F"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:text="Тёмная\nТёмная библиотека и ночное чтение"
                android:textColor="#1C1C1E"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/themeOptSystem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="#2A9D8F"
                android:checked="true"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:text="Системная\nСледует светлой/тёмной теме телефона"
                android:textColor="#1C1C1E"
                android:textSize="16sp" />
        </RadioGroup>

        <TextView
            android:id="@+id/themeOk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:background="?attr/selectableItemBackground"
            android:minWidth="72dp"
            android:minHeight="48dp"
            android:gravity="center"
            android:paddingHorizontal="20dp"
            android:paddingVertical="12dp"
            android:text="OK"
            android:textAllCaps="true"
            android:textColor="#1C1C1E"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
